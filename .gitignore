# Secrets (GCP project, API keys)
.env
.env.*
!.env.example

# GCP credentials, in case a service account key ends up here
*credentials*.json
*service-account*.json
*-key.json
.gcp-keys/

# Agent 365 CLI output (contains the blueprint client secret)
appsettings.json
a365.generated.config.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/

# ADK local session data created by `adk web` / `adk run`
.adk/

# Files the agent creates in the sandbox; keep only the sample file
workspace/*
!workspace/notes.txt

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
